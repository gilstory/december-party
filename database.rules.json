{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^[A-Z0-9]{6}$/)",
        "title": {
          ".write": "$room.matches(/^[A-Z0-9]{6}$/)",
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "participants": {
          "$pid": {
            ".write": "$room.matches(/^[A-Z0-9]{6}$/) && $pid.matches(/^[A-Za-z0-9_-]{1,40}$/)",
            ".validate": "newData.hasChildren(['name', 'dates'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "dates": {
              "$i": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31"
              }
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
